generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  password String
  role Role @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  MODERATOR
  ADMIN
  MEMBER
}

model SendMessage {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String?
  content   String
  ip        String?
  createdAt DateTime @default(now())
}

model Survey {

  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String?
  status        SurveyStatus @default(DRAFT)
  isPublic      Boolean  @default(true)
  allowMultipleResponses Boolean @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  questions     Question[]
  responses     Response[]
}

model Question {

  id            String @id @default(cuid())
  surveyId      String
  survey        Survey @relation(fields:[surveyId], references:[id], onDelete: Cascade)
  title         String
  description   String?
  type          QuestionType
  required      Boolean @default(false)
  order         Int
  placeholder   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  options        Option[]
  answers        Answer[]
}

model Response {

  id              String @id @default(cuid())
  surveyId        String
  survey          Survey @relation(fields:[surveyId], references:[id], onDelete: Cascade)
  submittedAt     DateTime @default(now())
  ipAddress       String?
  userAgent       String?
  answers         Answer[]
}

model Answer {

  id            String @id @default(cuid())
  responseId    String
  response      Response @relation(fields:[responseId], references:[id], onDelete: Cascade)
  questionId    String
  question      Question @relation(fields:[questionId], references:[id])
  value         Json
  createdAt     DateTime @default(now())
}

model Option {

  id          String @id @default(cuid())
  questionId  String
  question    Question @relation(fields:[questionId], references:[id], onDelete: Cascade)
  label       String
  value       String
  order       Int
  createdAt   DateTime @default(now())
}


enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  PHONE
  DATE

  RADIO
  CHECKBOX
  SELECT

  RATING
}

